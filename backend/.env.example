# Adigam AI — backend. Copy to .env and fill in. NEVER commit .env
NODE_ENV=development
PORT=4000
# Both local frontends. 5173 is `vite dev`; 4173 is `vite preview`, which serves the production
# build — worth having because it is the only way to see the real bundle and stylesheet locally, and
# a request from an origin missing here fails as "Could not reach the server" rather than as a CORS
# error, which sends you looking in the wrong place.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only. Bypasses RLS — must never reach the frontend.
SUPABASE_SECRET_KEY=

# Server-only. Never expose to the frontend. Added in Phase 11.
ANTHROPIC_API_KEY=
